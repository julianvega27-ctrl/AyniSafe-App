{
  "name": "ayni-safe-api",
  "version": "0.1.0",
  "private": true,
  "description": "API REST de AyniSafe (monolito modular). Modulo Identidad: acceso ciudadano.",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generar": "prisma generate",
    "db:verificar": "tsx scripts/verificar-conexion.ts",
    "db:local:init": "bash scripts/bd-local.sh init",
    "db:local:start": "bash scripts/bd-local.sh start",
    "db:local:stop": "bash scripts/bd-local.sh stop",
    "contrato:validar": "node scripts/validar-contrato.mjs",
    "admin:bootstrap": "tsx scripts/admin-bootstrap.ts",
    "admin:reiniciar": "tsx scripts/admin-reiniciar.ts",
    "test:unidad": "vitest run test/unidad",
    "test:integracion": "vitest run test/integracion",
    "db:migrar": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.10",
    "express": "5.3.0",
    "nodemailer": "10.6.1",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@types/express": "5.0.6",
    "@types/node": "24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.15.5",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "prisma": "7.10.1",
    "smtp-server": "3.21.7",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.1"
  }
}
