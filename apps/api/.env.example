# Copia este archivo a .env y completa los valores. Nunca subas .env a Git.
NODE_ENV=development
PORT=3000
# Saltos de proxy de confianza (0 = sin proxy; en Render, 1). Ver README.
TRUST_PROXY_HOPS=0
# Los genera scripts/bd-local.sh en .env; aqui solo se muestra la forma. Nunca subas credenciales reales.
DATABASE_URL=postgresql://usuario:contrasena@127.0.0.1:5433/ayni_safe_dev
TEST_DATABASE_URL=postgresql://usuario:contrasena@127.0.0.1:5433/ayni_safe_test
# Secreto (minimo 32 caracteres) para derivar con HMAC las claves del limitador de intentos.
RATE_LIMIT_HMAC_SECRET=cambia-este-valor-por-uno-aleatorio-de-32-o-mas-caracteres
# Secreto (minimo 32 caracteres) para la huella del codigo de seguimiento del invitado y del contenido
# de cada envio de incidente. Obligatorio para el servidor. Cambiarlo invalida los codigos ya emitidos.
TRACKING_CODE_HMAC_SECRET=cambia-este-valor-por-otro-aleatorio-de-32-o-mas-caracteres
# --- Web institucional ---
# Origen publico de la web (Vercel), sin ruta. La web sirve tambien la API por reescritura de /api/*,
# asi que ambas variables son el mismo origen. En produccion son obligatorias, https y deben coincidir.
# Origin permitido en las rutas con cookie y base de los enlaces de activacion de administradores.
# En local por defecto http://localhost:5173 (Vite).
WEB_ORIGIN=http://localhost:5173
# WEB_PUBLIC_URL=http://localhost:5173
# Opcionales (valores por defecto entre parentesis):
# RL_REGISTRO_IP_MAX=5  RL_LOGIN_IP_MAX=30  RL_LOGIN_CORREO_IP_MAX=5
# RL_LOGIN_INST_IP_MAX=30  RL_LOGIN_INST_CORREO_IP_MAX=5   (acceso institucional)
# HASH_MAX_CONCURRENCIA=4  HASH_MAX_COLA=16

# --- Recuperacion de contrasena y activacion de cuentas (correo) ---
# Origen publico de la API, sin ruta: base de los enlaces del correo y de los App Links.
# En produccion es obligatorio y debe ser https. En local, por defecto http://127.0.0.1:PORT.
API_PUBLIC_URL=
# Adaptador de correo: gmail-api | smtp | archivo | prueba.
#   archivo (desarrollo, por defecto): escribe cada correo en .correos-dev/ sin enviar nada.
#   prueba  (tests): en memoria.
#   gmail-api: envio real por HTTPS (443) con OAuth; es el de produccion (Render Free bloquea el SMTP).
#   smtp: envio real por SMTP; solo local u hosts que lo permitan.
# En produccion solo se admiten gmail-api y smtp.
EMAIL_ADAPTER=archivo
# Solo con EMAIL_ADAPTER=gmail-api (ver README, seccion Gmail API). Nunca se suben a Git.
# GMAIL_CLIENT_ID=...apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=secreto-del-cliente
# GMAIL_REFRESH_TOKEN=lo-guarda-scripts/obtener-refresh-token.mjs
# MAIL_REMITENTE_DIRECCION=cuenta-dedicada@gmail.com   (obligatoria con gmail-api: la cuenta que autorizo el token)
# Solo con EMAIL_ADAPTER=smtp. La contrasena de aplicacion de Gmail nunca se sube a Git.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USUARIO=cuenta-dedicada@gmail.com
# SMTP_CLAVE=contrasena-de-aplicacion
# MAIL_REMITENTE_NOMBRE=AyniSafe
# MAIL_REMITENTE_DIRECCION=   (por defecto, igual que SMTP_USUARIO; con Gmail debe coincidir)
# Tope diario global de solicitudes de recuperacion (cuota de Gmail: 500/dia).
# EMAIL_DIARIO_MAX=400
# Limites de abuso (valores por defecto entre parentesis):
# RL_RECUP_IP_MAX=10  RL_RECUP_CORREO_IP_MAX=3  RL_RECUP_CORREO_MAX=3  RL_TOKEN_IP_MAX=20
# App Links de Android: paquete y huellas SHA-256 del certificado de firma, separadas por comas.
# Sin huellas, /.well-known/assetlinks.json responde 404.
# ANDROID_PACKAGE=pe.edu.unsch.ayni_safe
# ANDROID_CERT_SHA256=AA:BB:...(32 bytes en hexadecimal separados por dos puntos)
