// Esquema de Identidad (cuentas y organizacion, P3.2), catalogo territorial de Consultas (P3.1)
// y catalogo de categorias de Reportes (P3.2). Ver
// openspec/changes/registro-login-ciudadano/design.md, seccion 5.
// Las restricciones que Prisma no expresa (CHECK) viven en el SQL de la migracion.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Distrito {
  id         String @id
  nombre     String @unique
  geometrias GeometriaDistrital[]
  sedesUbicadas Sede[]
  coberturas CoberturaSede[]
  @@map("distritos")
}

model VersionTerritorial {
  id          String @id
  metadatos   Json
  creadoEn    DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  geometrias  GeometriaDistrital[]
  activaEn    EstadoTerritorial[]
  @@map("versiones_territoriales")
}

model GeometriaDistrital {
  versionId String @map("version_id")
  distritoId String @map("distrito_id")
  ubigeo String
  geometria Json
  bbox Float[]
  version VersionTerritorial @relation(fields: [versionId], references: [id], onDelete: Restrict)
  distrito Distrito @relation(fields: [distritoId], references: [id], onDelete: Restrict)
  @@id([versionId, distritoId])
  @@unique([versionId, ubigeo])
  @@map("geometrias_distritales")
}

model EstadoTerritorial {
  ambito String @id
  versionId String? @map("version_id")
  version VersionTerritorial? @relation(fields: [versionId], references: [id], onDelete: Restrict)
  @@map("estado_territorial")
}

enum RolUsuario {
  ciudadano
  operador
  administrador
}

enum EstadoUsuario {
  activo
  suspendido
  /// Cuenta invitada que aun no definio su contrasena. No autentica ni tiene sesiones.
  pendiente_activacion
}

enum PropositoToken {
  recuperacion
  activacion
}

enum EstadoEnvio {
  pendiente
  enviando
  enviado
  fallido
}

model Usuario {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String
  /// Correo recortado y en minusculas: clave de identidad unica.
  correoNormalizado String        @unique @map("correo_normalizado")
  /// Hash Argon2id codificado (con parametros y sal). Nunca la contrasena. Nulo en cuentas pendientes de
  /// activacion y presente en las activas; una suspendida puede no tenerlo si nunca se activo (CHECK en la migracion).
  passwordHash      String?       @map("password_hash")
  rol               RolUsuario
  estado            EstadoUsuario
  /// Telefono opcional normalizado (7 a 15 digitos, '+' inicial opcional). Restricciones CHECK en la migracion.
  telefono          String?
  /// Fecha en que el titular autorizo compartir su telefono. Nulo = no autorizado; exige telefono.
  telefonoCompartirConsentidoAt DateTime? @map("telefono_compartir_consentido_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sesiones          Sesion[]
  tokensCuenta      TokenCuenta[]
  enviosCorreo      EnvioCorreo[]
  sedesCreadas      Sede[]
  pertenencia       PertenenciaOperador?

  @@map("usuarios")
}

model Sesion {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId String    @map("usuario_id") @db.Uuid
  /// SHA-256 (hex) del token opaco. El token en claro no se guarda.
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  usuario   Usuario   @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([usuarioId])
  @@map("sesiones")
}

model VentanaIntentos {
  /// 'registro_ip', 'login_ip' o 'login_correo_ip'.
  tipo          String
  /// HMAC del identificador (IP o correo+IP). Nunca valores en claro.
  claveHash     String   @map("clave_hash")
  ventanaInicio DateTime @map("ventana_inicio") @db.Timestamptz(3)
  contador      Int

  @@id([tipo, claveHash, ventanaInicio])
  @@index([ventanaInicio])
  @@map("ventanas_intentos")
}

/// Token de un solo uso para recuperar contrasena o activar una cuenta invitada.
model TokenCuenta {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  usuarioId   String         @map("usuario_id") @db.Uuid
  proposito   PropositoToken
  /// SHA-256 (hex) del token. El token en claro no se guarda.
  tokenHash   String         @unique @map("token_hash")
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt      DateTime?      @map("used_at") @db.Timestamptz(3)
  /// Se marca al emitir un token nuevo del mismo usuario y proposito, o al consumir otro.
  invalidadoAt DateTime?     @map("invalidado_at") @db.Timestamptz(3)
  usuario     Usuario        @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([usuarioId, proposito])
  @@index([expiresAt])
  @@map("tokens_cuenta")
}

/// Cola minima de correos. No guarda tokens ni enlaces: el token se genera al enviar.
/// El indice unico parcial de envios activos vive en el SQL de la migracion.
model EnvioCorreo {
  id               String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tipo             PropositoToken
  usuarioId        String      @map("usuario_id") @db.Uuid
  estado           EstadoEnvio @default(pendiente)
  intentos         Int         @default(0)
  proximoIntentoAt DateTime    @map("proximo_intento_at") @db.Timestamptz(3)
  reclamadoHasta   DateTime?   @map("reclamado_hasta") @db.Timestamptz(3)
  venceAt          DateTime    @map("vence_at") @db.Timestamptz(3)
  /// Codigo generico del fallo; nunca texto del proveedor.
  ultimoCodigoError String?    @map("ultimo_codigo_error")
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  enviadoAt        DateTime?   @map("enviado_at") @db.Timestamptz(3)
  usuario          Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([estado, proximoIntentoAt])
  @@index([usuarioId])
  @@map("envios_correo")
}

/// Catalogo cerrado de las 16 categorias (modulo Reportes). Sin edicion libre.
model Categoria {
  id           String @id
  nombre       String @unique
  orden        Int    @unique @db.SmallInt
  activa       Boolean @default(true)
  competencias CompetenciaSede[]
  @@map("categorias")
}

/// Catalogo institucional cerrado: pnp, bomberos, samu y serenazgo (CHECK en la migracion).
model Institucion {
  id            String   @id
  tipo          String   @unique
  nombre        String
  contacto      String?
  activa        Boolean  @default(true)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(3)
  sedes         Sede[]
  @@map("instituciones")
}

model Sede {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  institucionId       String    @map("institucion_id")
  nombre              String
  nombreNormalizado   String    @map("nombre_normalizado")
  distritoUbicacionId String?   @map("distrito_ubicacion_id")
  direccion           String?
  contacto            String?
  verificacion        String    @default("sin_verificar")
  fuenteVerificacion  String?   @map("fuente_verificacion")
  verificadaEn        DateTime? @map("verificada_en") @db.Date
  habilitadaAtencion  Boolean   @default(false) @map("habilitada_atencion")
  activa              Boolean   @default(true)
  esDemostracion      Boolean   @default(false) @map("es_demostracion")
  creadoPor           String    @map("creado_por") @db.Uuid
  creadoEn            DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn       DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(3)
  institucion         Institucion @relation(fields: [institucionId], references: [id], onDelete: Restrict)
  distritoUbicacion   Distrito?   @relation(fields: [distritoUbicacionId], references: [id], onDelete: Restrict)
  creador             Usuario     @relation(fields: [creadoPor], references: [id], onDelete: Restrict)
  operadores          PertenenciaOperador[]
  coberturas          CoberturaSede[]
  competencias        CompetenciaSede[]
  @@unique([institucionId, nombreNormalizado], map: "sedes_nombre_por_institucion")
  @@map("sedes")
}

/// Cada operador pertenece a exactamente una sede (trigger de rol en la migracion).
model PertenenciaOperador {
  usuarioId      String   @id @map("usuario_id") @db.Uuid
  sedeId         String   @map("sede_id") @db.Uuid
  esDemostracion Boolean  @default(false) @map("es_demostracion")
  creadoEn       DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  sede           Sede     @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  @@index([sedeId])
  @@map("pertenencias_operador")
}

model CoberturaSede {
  sedeId     String   @map("sede_id") @db.Uuid
  distritoId String   @map("distrito_id")
  sede       Sede     @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  distrito   Distrito @relation(fields: [distritoId], references: [id], onDelete: Restrict)
  @@id([sedeId, distritoId])
  @@index([distritoId])
  @@map("coberturas_sede")
}

model CompetenciaSede {
  sedeId      String    @map("sede_id") @db.Uuid
  categoriaId String    @map("categoria_id")
  sede        Sede      @relation(fields: [sedeId], references: [id], onDelete: Restrict)
  categoria   Categoria @relation(fields: [categoriaId], references: [id], onDelete: Restrict)
  @@id([sedeId, categoriaId])
  @@index([categoriaId])
  @@map("competencias_sede")
}

/// Evento de negocio persistido en la transaccion del hecho (P4.1, ADR-004). Carga sin datos personales.
model Evento {
  id          String   @id @db.Uuid
  tipo        String
  version     Int      @db.SmallInt
  agregadoId  String   @map("agregado_id") @db.Uuid
  carga       Json
  ocurridoEn  DateTime @default(now()) @map("ocurrido_en") @db.Timestamptz(3)
  entregas    EntregaEvento[]
  @@index([tipo, ocurridoEn], map: "eventos_tipo_ocurrido_en_idx")
  @@map("eventos")
}

/// Entrega de un evento a un consumidor, con reintentos y bloqueo (CHECK en la migracion).
model EntregaEvento {
  eventoId         String    @map("evento_id") @db.Uuid
  consumidor       String
  estado           String    @default("pendiente")
  intentos         Int       @default(0)
  proximoIntentoEn DateTime  @default(now()) @map("proximo_intento_en") @db.Timestamptz(3)
  bloqueadoHasta   DateTime? @map("bloqueado_hasta") @db.Timestamptz(3)
  ultimoError      String?   @map("ultimo_error")
  creadaEn         DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)
  procesadaEn      DateTime? @map("procesada_en") @db.Timestamptz(3)
  evento           Evento    @relation(fields: [eventoId], references: [id], onDelete: Restrict)
  @@id([eventoId, consumidor])
  @@map("entregas_evento")
}

/// Incidente unico (modulo Operaciones, P4.1). Estados y formato de referencia con CHECK en la migracion.
model Incidente {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referencia   String   @unique
  estado       String   @default("REGISTRADO")
  registradoEn DateTime @default(now()) @map("registrado_en") @db.Timestamptz(3)
  enrutamiento EnrutamientoIncidente?
  @@map("incidentes")
}

/// P4.2 (Operaciones): regla aplicada, condiciones y resultado del enrutamiento de un incidente.
model EnrutamientoIncidente {
  incidenteId             String    @id @map("incidente_id") @db.Uuid
  eventoId                String    @unique @map("evento_id") @db.Uuid
  versionRegla            String    @map("version_regla")
  categoriaId             String    @map("categoria_id")
  distritoId              String?   @map("distrito_id")
  resultado               String
  revisionMedicaPendiente Boolean   @map("revision_medica_pendiente")
  faltantes               Json      @default("[]")
  registradoEn            DateTime  @map("registrado_en") @db.Timestamptz(3)
  creadoEn                DateTime  @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn           DateTime  @default(now()) @map("actualizado_en") @db.Timestamptz(3)
  incidente               Incidente @relation(fields: [incidenteId], references: [id], onDelete: Restrict)
  participaciones         ParticipacionIncidente[]
  @@index([registradoEn, incidenteId], map: "enrutamientos_pendientes_fifo")
  @@map("enrutamientos_incidente")
}

/// P4.2 (Operaciones): participacion de una sede en un incidente; nunca se borra.
model ParticipacionIncidente {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidenteId  String   @map("incidente_id") @db.Uuid
  sedeId       String   @map("sede_id") @db.Uuid
  institucion  String
  papel        String
  origen       String
  designadoPor String?  @map("designado_por") @db.Uuid
  motivo       String?
  creadoEn     DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  actualizadoEn DateTime @default(now()) @map("actualizado_en") @db.Timestamptz(3)
  enrutamiento EnrutamientoIncidente @relation(fields: [incidenteId], references: [incidenteId], onDelete: Restrict)
  @@unique([incidenteId, sedeId], map: "participaciones_una_por_sede")
  @@index([sedeId, incidenteId], map: "participaciones_sede_incidente")
  @@map("participaciones_incidente")
}

/// Originales del envio ciudadano (modulo Reportes, P4.1). Coherencia de modalidad y territorio con CHECK en la migracion.
model EnvioIncidente {
  incidenteId        String    @id @map("incidente_id") @db.Uuid
  modalidad          String
  autorUsuarioId     String?   @map("autor_usuario_id") @db.Uuid
  telefonoContacto   String?   @map("telefono_contacto")
  codigoHuella       String?   @map("codigo_huella")
  codigoEmitidoEn    DateTime? @map("codigo_emitido_en") @db.Timestamptz(3)
  categoriaId        String    @map("categoria_id")
  descripcion        String
  ocurrenciaModo     String    @map("ocurrencia_modo")
  ocurridoEn         DateTime  @map("ocurrido_en") @db.Timestamptz(3)
  latitud            Float
  longitud           Float
  origenPunto        String    @map("origen_punto")
  precisionM         Float?    @map("precision_m")
  distritoId         String?   @map("distrito_id")
  estadoTerritorial  String    @map("estado_territorial")
  motivoTerritorial  String?   @map("motivo_territorial")
  versionTerritorial String?   @map("version_territorial")
  heridos            String?
  atencionMedica     String?   @map("atencion_medica")
  recibidoEn         DateTime  @map("recibido_en") @db.Timestamptz(3)
  @@map("envios_incidente")
}

/// Claves de idempotencia por ambito (cuenta:<uuid> o invitado) y huella HMAC del contenido.
model SolicitudEnvio {
  ambito          String
  clave           String   @db.Uuid
  huellaContenido String   @map("huella_contenido")
  incidenteId     String   @unique @map("incidente_id") @db.Uuid
  creadoEn        DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  @@id([ambito, clave])
  @@map("solicitudes_envio")
}

/// P5.1 (Operaciones): auditoria de cada recalculo del enrutamiento por la condicion medica, sin datos sanitarios.
model CambioEnrutamiento {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidenteId       String   @map("incidente_id") @db.Uuid
  versionEvaluacion Int      @map("version_evaluacion")
  origen            String
  actorTipo         String   @map("actor_tipo")
  actorUsuarioId    String?  @map("actor_usuario_id") @db.Uuid
  antes             Json
  despues           Json
  creadoEn          DateTime @default(now()) @map("creado_en") @db.Timestamptz(3)
  @@index([incidenteId, creadoEn], map: "cambios_enrutamiento_incidente")
  @@map("cambios_enrutamiento")
}

/// P5.1 (Reportes): evaluacion vigente. Con heridos 'si', cantidad null = desconocida. CHECK en la migracion.
model EvaluacionIncidente {
  incidenteId    String   @id @map("incidente_id") @db.Uuid
  versionVigente Int      @map("version_vigente")
  heridos        String?
  atencionMedica String?  @map("atencion_medica")
  cantidadHeridos Int?    @map("cantidad_heridos") @db.SmallInt
  signosVida     String?  @map("signos_vida")
  consciente     String?
  sangrado       String?
  samuRequerido  Boolean  @map("samu_requerido")
  actualizadaEn  DateTime @default(now()) @map("actualizada_en") @db.Timestamptz(3)
  versiones      VersionEvaluacion[]
  accesos        AccesoEvaluacion[]
  @@map("evaluaciones_incidente")
}

/// P5.1 (Reportes): version inmutable con la instantanea completa, origen y campos modificados.
model VersionEvaluacion {
  incidenteId       String   @map("incidente_id") @db.Uuid
  version           Int
  heridos           String?
  atencionMedica    String?  @map("atencion_medica")
  cantidadHeridos   Int?     @map("cantidad_heridos") @db.SmallInt
  signosVida        String?  @map("signos_vida")
  consciente        String?
  sangrado          String?
  origen            String
  actorUsuarioId    String?  @map("actor_usuario_id") @db.Uuid
  institucion       String?
  camposModificados String[] @default([]) @map("campos_modificados")
  motivo            String?
  creadaEn          DateTime @default(now()) @map("creada_en") @db.Timestamptz(3)
  evaluacion        EvaluacionIncidente @relation(fields: [incidenteId], references: [incidenteId], onDelete: Restrict)
  @@id([incidenteId, version])
  @@map("versiones_evaluacion")
}

/// P5.1 (Reportes): lectura autorizada del detalle sanitario, sin contenido.
model AccesoEvaluacion {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  incidenteId String   @map("incidente_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  version     Int
  accedidoEn  DateTime @default(now()) @map("accedido_en") @db.Timestamptz(3)
  evaluacion  EvaluacionIncidente @relation(fields: [incidenteId], references: [incidenteId], onDelete: Restrict)
  @@index([incidenteId, accedidoEn], map: "accesos_evaluacion_incidente")
  @@map("accesos_evaluacion")
}

/// P5.2 (Reportes): foto adjunta. public_id registrado antes de subir; ranura 1-3 unica entre no eliminadas
/// (indice parcial y CHECK en la migracion). Una fila eliminada es la marca sin contenido.
model EvidenciaIncidente {
  id                  String    @id @db.Uuid
  incidenteId         String    @map("incidente_id") @db.Uuid
  ranura              Int       @db.SmallInt
  publicId            String    @unique @map("public_id")
  proveedor           String
  estado              String
  tipoMedio           String    @map("tipo_medio")
  bytes               Int
  ancho               Int?
  alto                Int?
  sha256              String?
  huellaCarga         String    @map("huella_carga")
  claveIdempotencia   String    @map("clave_idempotencia") @db.Uuid
  modalidad           String
  autorUsuarioId      String?   @map("autor_usuario_id") @db.Uuid
  creadaEn            DateTime  @default(now()) @map("creada_en") @db.Timestamptz(3)
  confirmadaEn        DateTime? @map("confirmada_en") @db.Timestamptz(3)
  eliminadaEn         DateTime? @map("eliminada_en") @db.Timestamptz(3)
  motivoEliminacion   String?   @map("motivo_eliminacion")
  intentosEliminacion Int       @default(0) @map("intentos_eliminacion")
  proximoIntentoEn    DateTime? @map("proximo_intento_en") @db.Timestamptz(3)
  accesos             AccesoEvidencia[]
  // Indices unicos parciales (ranura activa; clave entre pendiente/disponible) solo en la migracion.
  @@map("evidencias_incidente")
}

/// P5.2 (Reportes): huella HMAC del permiso de carga del invitado (24 h).
model PermisoEvidencia {
  incidenteId   String   @id @map("incidente_id") @db.Uuid
  permisoHuella String   @map("permiso_huella")
  emitidoEn     DateTime @default(now()) @map("emitido_en") @db.Timestamptz(3)
  venceEn       DateTime @map("vence_en") @db.Timestamptz(3)
  @@map("permisos_evidencia")
}

/// P5.2 (Reportes): lectura autorizada del contenido de una foto, sin contenido.
model AccesoEvidencia {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  evidenciaId String   @map("evidencia_id") @db.Uuid
  usuarioId   String   @map("usuario_id") @db.Uuid
  rol         String
  accedidoEn  DateTime @default(now()) @map("accedido_en") @db.Timestamptz(3)
  evidencia   EvidenciaIncidente @relation(fields: [evidenciaId], references: [id], onDelete: Restrict)
  @@index([evidenciaId, accedidoEn], map: "accesos_evidencia_evidencia")
  @@map("accesos_evidencia")
}
